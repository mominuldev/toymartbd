{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "toymartbd",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*",
        "toymartbd-app/storefront"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js",
        "lint:i18n": "node --test scripts/i18n/i18n.test.mjs && node scripts/i18n/lint.mjs && node scripts/i18n/check-keys.mjs",
        "lint:i18n:admin": "node scripts/i18n/lint.mjs admin && node scripts/i18n/check-keys.mjs admin",
        "lint:i18n:storefront": "node scripts/i18n/lint.mjs storefront && node scripts/i18n/check-keys.mjs storefront",
        "test": "vitest run",
        "dev:storefront": "npm run dev --workspace=storefront",
        "build:storefront": "npm run build --workspace=storefront",
        "start:storefront": "npm run start --workspace=storefront",
        "typecheck:storefront": "npm run typecheck --workspace=storefront",
        "test:storefront": "npm run test --workspace=storefront",
        "test:e2e:storefront": "npm run test:e2e --workspace=storefront",
        "tokens:build": "npm run build --workspace=@toymart/tokens",
        "api-types:generate": "npm run generate --workspace=@toymart/api-types",
        "test:e2e:admin": "playwright test --config e2e/admin/playwright.config.ts",
        "test:a11y:admin": "playwright test --config e2e/admin-a11y/playwright.config.ts"
    },
    "dependencies": {
        "@hookform/resolvers": "6.0.1",
        "@phosphor-icons/react": "2.1.10",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-table": "^9.3.1",
        "@tiptap/extension-image": "^3.33.1",
        "@tiptap/pm": "^3.33.1",
        "@tiptap/react": "^3.33.1",
        "@tiptap/starter-kit": "^3.33.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-router": "^8.5.1",
        "recharts": "^3.10.1",
        "zod": "^4.6.7",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@playwright/test": "1.64.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/react": "16.3.3",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "eslint": "^10.14.0",
        "jsdom": "30.1.3",
        "laravel-vite-plugin": "^3.2.1",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    }
}
