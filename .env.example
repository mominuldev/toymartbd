APP_NAME="Toy Mart BD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For (the Next.js storefront server,
# the load balancer). Default none; '*' is refused. See config/trustedproxy.php.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production / staging: LOG_STACK=json (one JSON object per line on stdout, request_id on every line).
LOG_STACK=single
# LOG_JSON_STREAM=php://stdout
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Storage is UTC, always (see APP_DISPLAY_TIMEZONE below). config/app.php pins it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=toymartbd
DB_USERNAME=root
DB_PASSWORD=secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: SESSION_DOMAIN=.toymartbd.com, SESSION_SECURE_COOKIE=true

# Origins that get the admin cookie session + CSRF (the admin SPA is served by this app).
# Production: SANCTUM_STATEFUL_DOMAINS=admin.toymartbd.com
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000
# Prefix on issued API tokens so secret scanners can spot a leak.
SANCTUM_TOKEN_PREFIX=tmbd_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Media pipeline (config/media.php). Renditions go to MEDIA_DISK (public); sanitised
# masters stay private on MEDIA_ORIGINALS_DISK. MEDIA_CDN_URL, when set, is the public
# base for rendition URLs (owner decision pending: CDN/object-storage host).
MEDIA_DISK=public
MEDIA_ORIGINALS_DISK=local
MEDIA_CDN_URL=
MEDIA_QUEUE=index
# Demo seed (local/testing only): attach the Figma product photos through the pipeline.
# Unset = on in local, off elsewhere. ~16 products × 9 renditions; set false for a fast seed.
# DEMO_SEED_IMAGES=
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Toy Mart BD ---------------------------------------------------------
# Display timezone and report day-boundaries. Storage stays UTC (APP_TIMEZONE).
# All "daily" reports MUST bucket by this zone, not by UTC.
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
APP_SUPPORTED_LOCALES=en,bn

# Storefront (Next.js) — used to sign ISR revalidation callbacks
STOREFRONT_URL=http://localhost:3000
STOREFRONT_REVALIDATE_SECRET=

# Search
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=local-master-key-change-me

# Payment gateway — SSLCommerz (sandbox first; see docs/PRODUCT-REQUIREMENTS.md §5)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Optional: browser return base (defaults to STOREFRONT_URL) and IPN source-IP allowlist
SSLCOMMERZ_RETURN_URL=
SSLCOMMERZ_IPN_ALLOWED_IPS=
# PLACEHOLDERS (owner decision): unpaid online order hold window, attempts per order
PAYMENT_ONLINE_EXPIRY_MINUTES=30
PAYMENT_ONLINE_MAX_ATTEMPTS=5

# Couriers.
# Pathao has a real sandbox. Steadfast has NONE — its API key is issued only on
# merchant-account creation, so its driver runs against fixtures and must stay
# unverified until a live account exists. See docs/SYSTEM-ARCHITECTURE.md §8.
PATHAO_SANDBOX=true
PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=

STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_VERIFIED=false

# Notifications. Order updates go over WhatsApp utility (~BDT 0.45); OTP stays on
# SMS, because Bangladesh sits on Meta's authentication-international tier.
SMS_DRIVER=log
# REVE SMS (set SMS_DRIVER=reve). Keys come from the provider's panel; never commit them.
SMS_REVE_BASE_URL=https://smpp.ajuratech.com:7790
SMS_REVE_API_KEY=
SMS_REVE_SECRET_KEY=
SMS_REVE_SENDER_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Server-side tracking (browser + server events deduplicated on a shared event_id)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Error tracking (P3-CI-04). Empty DSN = Sentry disabled. PII is never sent (config/sentry.php).
# SENTRY_RELEASE is the git SHA, set by the deploy.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Backups (P3-CI-03, docs/ops/backup-and-restore.md). The archive password must be
# kept OUTSIDE the backup (password manager + the host secret store), with APP_KEY.
# Production: BACKUP_DISK=backups_s3 with an off-host, versioned bucket.
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false
