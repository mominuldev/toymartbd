# Copy to .env.local. Every variable here is SERVER-ONLY — never prefix one with NEXT_PUBLIC_.

# Base URL of the Laravel API (no trailing slash).
API_URL=http://localhost:8000

# Origin of the admin (the homepage builder that frames the draft preview). REQUIRED for
# `next build` / `next start` (lib/env.ts); in dev it defaults to API_URL's origin.
ADMIN_URL=http://localhost:8000

# Optional, comma-separated: extra origins product media is served from (a CDN / object store),
# allowed in the Content-Security-Policy img-src. The API origin is always allowed.
# MEDIA_ORIGINS=https://media.example.com

# Sanctum token with the storefront:read ability. Mint one with:
#   php artisan toymart:storefront-token
STOREFRONT_API_TOKEN=

# Shared HMAC secret for POST /api/revalidate. Must equal STOREFRONT_REVALIDATE_SECRET in Laravel's .env.
STOREFRONT_REVALIDATE_SECRET=

# Public origin of this storefront, used for canonical and hreflang URLs.
SITE_URL=http://localhost:3000

# Error tracking (P10, docs/ops/observability.md). Empty DSN = Sentry off (no SDK loaded).
# The DSN is a public ingest key, so the browser one is the single NEXT_PUBLIC_ exception;
# events go through the same-origin tunnel /api/monitoring. Release = SENTRY_RELEASE, else
# Vercel's VERCEL_GIT_COMMIT_SHA.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Build-only (Vercel project env, never NEXT_PUBLIC_): source-map upload.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_STOREFRONT_PROJECT=

# Maintenance switch (docs/ops/DEPLOYMENT.md §5): "1" answers every page 503 with /maintenance. Off when absent.
# STOREFRONT_MAINTENANCE=1
