# Toy Mart BD — production .env (docs/ops/DEPLOYMENT.md §3). Lives ONLY on the server at
# {{APP_ROOT}}/shared/.env (owner deploy, mode 0600). Never commit a filled copy.
#
# provision.sh writes this file once, filling the values it generates (APP_KEY, database,
# Redis and Meilisearch passwords, the revalidate secret, the backup archive password). It never
# overwrites it afterwards. Every CHANGE_ME is the owner's to fill; a deploy refuses to run while
# any CHANGE_ME remains. Variable meanings: docs/ops/STAGING.md §3 (same names, production values).
#
# ESCROW (password manager, outside this server): APP_KEY and BACKUP_ARCHIVE_PASSWORD. Without
# APP_KEY the encrypted gateway/courier/SMS credentials cannot be read; without the archive
# password no backup can be opened.

APP_NAME="Toy Mart BD"
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_URL=https://{{PRIMARY_DOMAIN}}
# Leave empty unless a proxy/CDN (e.g. Cloudflare) sits in front of nginx; then its ranges.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_DISPLAY_TIMEZONE=Asia/Dhaka
APP_CURRENCY=BDT
APP_CURRENCY_SYMBOL=৳
APP_SUPPORTED_LOCALES=en,bn
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One JSON object per line, every process (PHP-FPM, Horizon, scheduler) into one file that
# logrotate rotates and a log shipper can tail (docs/ops/observability.md).
LOG_CHANNEL=stack
LOG_STACK=json
LOG_JSON_STREAM=/var/log/toymartbd/laravel.json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE={{DB_NAME}}
DB_USERNAME={{DB_USER}}
DB_PASSWORD={{DB_PASSWORD}}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD={{REDIS_PASSWORD}}
REDIS_PREFIX=tmbd_prod_
CACHE_PREFIX=tmbd_prod_
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# null = host-only cookie: the admin session is never sent to the storefront or another subdomain.
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# The admin is served by this host at /admin over a Sanctum cookie session.
SANCTUM_STATEFUL_DOMAINS={{SERVER_NAMES_CSV}}
SANCTUM_TOKEN_PREFIX=tmbd_

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
MEDIA_ORIGINALS_DISK=local
MEDIA_CDN_URL=
MEDIA_QUEUE=index

# Storefront (Vercel). The SAME revalidate secret goes into the Vercel project's env.
# The storefront origin, e.g. https://www.example.com (CORS, SSLCommerz return base, revalidation).
STOREFRONT_URL=CHANGE_ME
STOREFRONT_REVALIDATE_SECRET={{REVALIDATE_SECRET}}

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY={{MEILI_MASTER_KEY}}

# Mail (stock-drift, low-stock, report mails). Owner's SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=CHANGE_ME
MAIL_FROM_NAME="${APP_NAME}"

# Backups (docs/ops/backup-and-restore.md). Needs `composer require league/flysystem-aws-s3-v3`
# before BACKUP_DISK=backups_s3 works — until then backups go to the local disk (NOT off-host).
BACKUP_DISK=backups
BACKUP_ARCHIVE_PASSWORD={{BACKUP_ARCHIVE_PASSWORD}}
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

# Sentry — empty DSN = off. SENTRY_RELEASE is set by every deploy to the git sha; leave it empty.
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Payments: inactive until the owner has a verified merchant account (rule 33a).
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_RETURN_URL=
SSLCOMMERZ_IPN_ALLOWED_IPS=

# Couriers: empty until merchant accounts exist (rule 33a). Never a portal login (rule 24a).
PATHAO_SANDBOX=true
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_WEBHOOK_SECRET=
PATHAO_STORE_ID=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_VERIFIED=false

# SMS credentials are entered in Admin → Integrations → Messaging (STAGING.md §3.4); env is a fallback.
SMS_DRIVER=log
WHATSAPP_ENABLED=false

# Marketing tags (server-side events). Optional.
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
