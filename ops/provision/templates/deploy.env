# Toy Mart BD — non-secret deploy settings (ops/provision). {{APP_ROOT}}/deploy.env
# Read by bin/toymart-deploy (ops/deploy/deploy.sh). Secrets never go here — they live in shared/.env.
KEEP_RELEASES=5
HEALTH_URL=https://{{PRIMARY_DOMAIN}}/api/v1/health
HEALTH_RESOLVE={{PRIMARY_DOMAIN}}:443:127.0.0.1
RELOAD_CMD=sudo -n /usr/bin/systemctl reload php8.4-fpm
HORIZON_ENSURE_CMD=sudo -n /usr/bin/supervisorctl start toymartbd-horizon
