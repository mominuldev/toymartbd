# Toy Mart BD — MySQL 8.4 (ops/provision). /etc/mysql/mysql.conf.d/zz-toymartbd.cnf
[mysqld]
# CLAUDE.md rule 34: utf8mb4_0900_ai_ci throughout — Bangla text.
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
# Storage is UTC, always (config/app.php); reports bucket by Dhaka date in code (rule 11).
default-time-zone    = '+00:00'

bind-address         = 127.0.0.1
mysqlx-bind-address  = 127.0.0.1
skip-name-resolve

innodb_buffer_pool_size = {{MYSQL_BUFFER_POOL}}
max_connections         = 100

# Point-in-time recovery between nightly backups (docs/ops/backup-and-restore.md, RPO 1 h):
# binary logs are on by default in 8.4; keep 7 days.
binlog_expire_logs_seconds = 604800

slow_query_log      = ON
slow_query_log_file = /var/log/mysql/slow.log
long_query_time     = 1

[client]
default-character-set = utf8mb4
