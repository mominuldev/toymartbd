# Toy Mart BD — provisioning settings (docs/ops/DEPLOYMENT.md §2).
# Copy to /etc/toymartbd/provision.env on the server (root, 0600), fill it, then run
#   sudo bash ops/provision/provision.sh
# Nothing here is a secret except nothing: passwords are GENERATED on the server and never
# leave it (they land in /etc/toymartbd/generated.env and the app's shared/.env).

# Host names this server answers for. The first is the primary (APP_URL, TLS certificate name).
# The admin is served by the same app at /admin, so one name is enough; add e.g. an admin.
# subdomain only if you want one. Space-separated.
SERVER_NAMES="api.example.com"

# Let's Encrypt account e-mail (expiry warnings). Empty = skip TLS for now (HTTP-only 503 page).
CERTBOT_EMAIL=""

# Public key of the GitHub Actions deploy key (the private half is the DEPLOY_SSH_KEY secret).
DEPLOY_SSH_PUBKEY=""
# Optional: the owner's own public key, also allowed to log in as the deploy user.
OWNER_SSH_PUBKEY=""

# --- defaults below are fine for a 2–4 GB VPS ---------------------------------------------
# APP_ROOT=/var/www/toymartbd
# DEPLOY_USER=deploy
# DB_NAME=toymartbd
# DB_USER=toymartbd
# SSH_PORT=22
# SWAP_SIZE_MB=2048               # 0 = no swap file
# SSH_DISABLE_PASSWORD=yes        # only applied once a key login exists for root or a sudo user
# MEILI_VERSION=v1.15.2           # keep in step with docker-compose.yml (getmeili/meilisearch:v1.15)
# MEILI_SHA256=                   # optional: pin the binary's checksum (printed on first install)
# PHP_FPM_MAX_CHILDREN=           # computed from RAM when empty
# MYSQL_BUFFER_POOL=              # computed from RAM when empty (25 %)
