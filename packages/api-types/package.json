{
    "name": "@toymart/api-types",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "TypeScript types generated from the API's OpenAPI 3.1 document. Generated, never hand-edited.",
    "exports": {
        ".": "./src/index.ts",
        "./zod": "./src/zod.ts"
    },
    "scripts": {
        "generate": "openapi-typescript ../../docs/api/openapi.json -o src/schema.ts && node scripts/zod.mjs"
    },
    "devDependencies": {
        "openapi-typescript": "7.13.0"
    }
}
